<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <st:include page="id-and-description" class="${descriptor.clazz}"/>
  <f:entry title="${%Passphrase}" field="passphrase">
    <f:password/>
  </f:entry>
  <f:entry title="${%PGP Private Key}" field="armoredKey">
    <f:secretTextarea/>
  </f:entry>
  <script>
    <![CDATA[
    (function() {
      var textarea = document.querySelector('textarea[name="_.armoredKey"]');
      if (!textarea) return;
      textarea.form.addEventListener('submit', function() {
        if (textarea.value && !textarea.value.startsWith("SECRET-")) {
          textarea.value = textarea.value.replace(/(\r\n|\n|\r)/g, '');
        }
      }, true);
    })();
    ]]>
  </script>
</j:jelly>
