      <name>release</name>
      <tasks class="linked-list">
        <org.jenkinsci.plugins.artifact.deployment.tasks.SectionTask>
          <name>Production Deploy</name>
          <requirements class="linked-list">
            <org.jenkinsci.plugins.artifact.deployment.tasks.BlockReplayedCpsCheck/>
            <org.jenkinsci.plugins.artifact.deployment.tasks.MatchBranchDefaultCpsCheck/>
            <org.jenkinsci.plugins.artifact.deployment.tasks.ResultCpsCheck>
              <matchType>equal</matchType>
              <value>SUCCESS</value>
            </org.jenkinsci.plugins.artifact.deployment.tasks.ResultCpsCheck>
          </requirements>
          <skipOnFailedCheck>true</skipOnFailedCheck>
          <tasks class="linked-list">
            <org.jenkinsci.plugins.artifact.deployment.repos.SonatypeNexusUploadTask>
              <repoId>83766c89-09c9-420a-8dec-e1219193c323</repoId>
            </org.jenkinsci.plugins.artifact.deployment.repos.SonatypeNexusUploadTask>
            <org.jenkinsci.plugins.artifact.deployment.tasks.GitTagPushTask>
              <entries>
                <org.jenkinsci.plugins.artifact.deployment.tasks.MetadataFileExtensionEntry>
                  <key>ext</key>
                </org.jenkinsci.plugins.artifact.deployment.tasks.MetadataFileExtensionEntry>
                <org.jenkinsci.plugins.artifact.deployment.tasks.CustomMetadataEntry>
                  <key>groupId</key>
                  <metakeys class="java.util.ImmutableCollections$ListN" resolves-to="java.util.CollSer" serialization="custom">
                    <java.util.CollSer>
                      <default>
                        <tag>4</tag>
                      </default>
