                    <java.util.CollSer>
                      <default>
                        <tag>4</tag>
                      </default>
                      <int>1</int>
                      <string>artifactId</string>
                    </java.util.CollSer>
                  </metakeys>
                </org.jenkinsci.plugins.artifact.deployment.tasks.CustomMetadataEntry>
                <org.jenkinsci.plugins.artifact.deployment.tasks.MetadataVersionEntry>
                  <key>version</key>
                </org.jenkinsci.plugins.artifact.deployment.tasks.MetadataVersionEntry>
              </entries>
              <triggerKey>ext</triggerKey>
              <triggerValueRegex>txt</triggerValueRegex>
              <tag>${ ext }/v${ version }</tag>
              <comment>[artifact] ${ groupId }:${ artifactId }:${ version }</comment>
              <force>true</force>
            </org.jenkinsci.plugins.artifact.deployment.tasks.GitTagPushTask>
          </tasks>
        </org.jenkinsci.plugins.artifact.deployment.tasks.SectionTask>
      </tasks>
