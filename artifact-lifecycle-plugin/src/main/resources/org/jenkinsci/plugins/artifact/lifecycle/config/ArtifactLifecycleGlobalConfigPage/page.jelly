<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
	<h2>${it.displayName}</h2>
	<f:form method="post" action="configure" name="config">
		<j:set var="descriptor" value="${it.configDescriptor}" />
		<j:set var="instance" value="${descriptor}" />
		<f:rowSet name="${descriptor.jsonSafeClassName}">
			<st:include from="${descriptor}"
				page="${descriptor.globalConfigPage}" />
		</f:rowSet>
		<f:saveApplyBar />
	</f:form>
</j:jelly>
