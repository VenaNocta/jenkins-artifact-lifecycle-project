<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
	<input type="hidden" name="uuid"
		value="${instance == null ? null : instance.uuid}" />
	<div style="display:flex; gap:20px; width:100%;">
		<div style="flex:0 0 auto;">
			<f:entry title="${%ID}">
				<div style="color:#888; white-space:nowrap;">
					${instance == null ? "???" : instance.uuid}
				</div>
			</f:entry>
		</div>
		<div style="flex:1; min-width:0;">
			<f:entry title="${%Types}">
				<div style="display:flex; flex-wrap:wrap; gap:6px;">
					<j:forEach var="type"
						items="${descriptor.getProviderTypes(instance)}">
						<span
							style="border:1px solid #888; border-radius:4px; padding:2px 6px; color:#888; white-space:nowrap;">
							${type}
						</span>
					</j:forEach>
				</div>
			</f:entry>
		</div>
	</div>
	<f:entry title="${%Name}" field="name">
		<f:textbox />
	</f:entry>
	<f:entry title="${%Description}" field="description">
		<f:textbox />
	</f:entry>
</j:jelly>
