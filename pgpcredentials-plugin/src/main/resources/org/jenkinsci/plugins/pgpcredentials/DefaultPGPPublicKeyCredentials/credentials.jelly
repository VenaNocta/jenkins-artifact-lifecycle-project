<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <j:invokeStatic var="armoredKeyTitle" className="org.jenkinsci.plugins.pgpcredentials.Messages" method="PGPPublicKeyCredentials_Desc_ArmoredKey"/>
  <st:include page="id-and-description" class="${descriptor.clazz}"/>
  <f:entry title="${armoredKeyTitle}" field="armoredKey">
    <f:textarea/>
  </f:entry>
</j:jelly>
