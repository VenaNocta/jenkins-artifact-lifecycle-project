<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <j:invokeStatic var="passphraseTitle" className="org.jenkinsci.plugins.pgpcredentials.Messages" method="PGPPrivateKeyCredentials_Desc_Passphrase"/>
  <j:invokeStatic var="armoredKeyTitle" className="org.jenkinsci.plugins.pgpcredentials.Messages" method="PGPPrivateKeyCredentials_Desc_ArmoredKey"/>
  <st:include page="id-and-description" class="${descriptor.clazz}"/>
  <f:entry title="${passphraseTitle}" field="passphrase">
    <f:password/>
  </f:entry>
  <f:entry title="${armoredKeyTitle}" field="armoredKey">
    <f:secretTextarea/>
  </f:entry>
</j:jelly>
