<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:c="/lib/credentials" xmlns:l="/lib/layout"
	xmlns:st="jelly:stapler">
	<st:include page="uuid-and-base-values"
		class="${descriptor.clazz}" />
	<f:entry title="${%Namespace}" field="namespace">
		<f:textbox />
	</f:entry>
	<f:entry title="${%Down-/Upload Credentials}"
		field="credentialsId">
		<c:select />
	</f:entry>
	<f:entry title="${%Enable 'AUTOMATIC' Publishing Mode}"
		field="allowAutoPublish">
		<f:checkbox />
	</f:entry>
	<f:entry title="${%Default Publishing Mode}"
		field="publishingType">
		<f:select />
	</f:entry>
</j:jelly>
