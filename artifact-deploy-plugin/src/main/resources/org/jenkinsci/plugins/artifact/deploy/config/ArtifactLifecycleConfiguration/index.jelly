<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:local="local">
	<l:layout title="${%Artifact Lifecycle}" norefresh="true">
		<st:include page="sidepanel"/>
		<l:main-panel>
			<j:choose>
            	<j:when test="${it == null}">
            		<st:include page="config"/>
            	</j:when>
        	    <j:otherwise>
    	        	<st:include page="config" it="${it}"/>
	            </j:otherwise>
            </j:choose>
		</l:main-panel>
	</l:layout>
</j:jelly>
