<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:c="/lib/credentials" xmlns:l="/lib/layout"
	xmlns:st="jelly:stapler">
	<st:include page="uuid-and-base-values"
		class="${descriptor.clazz}" />
	<f:entry title="${%Server}" field="uri">
		<f:textbox />
	</f:entry>
	<f:entry title="${%Repository}" field="repo">
		<f:select />
	</f:entry>
	<f:entry title="${%Down-/Upload Credentials}"
		field="credentialId">
		<c:select />
	</f:entry>
</j:jelly>
