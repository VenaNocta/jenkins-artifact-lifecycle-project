<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
	<j:invokeStatic var="title"
		className="org.jenkinsci.plugins.repoproxy.config.Messages"
		method="FolderProperty_Proxy_DisplayName" />
	<!-- page -->
	<f:section title="${title}">
		<f:entry title="Inherit upstream Repo Mappings"
			field="inheritNameMappings">
			<f:checkbox default="true" />
		</f:entry>
		<f:entry title="Name-Proxy Mappings">
			<f:repeatableProperty field="nameMappings2"
				header="Name-Mapping" />
		</f:entry>
	</f:section>
</j:jelly>
