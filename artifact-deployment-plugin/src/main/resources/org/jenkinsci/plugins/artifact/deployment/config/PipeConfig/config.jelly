<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
	<!-- page -->
	<f:repeatableDeleteButton />
	<input type="hidden" name="uuid"
		value="${instance == null ? null : instance.uuid}" />
	<f:entry title="${%ID}">
		<div style="color:#888">
			${instance == null ? "???" : instance.uuid}
		</div>
	</f:entry>
	<f:entry title="Name" field="name">
		<f:textbox />
	</f:entry>
	<f:entry title="Description" field="description">
		<f:textbox />
	</f:entry>
	<f:entry title="Tasks">
		<f:repeatableHeteroProperty field="tasks"
			hasHeader="true" />
	</f:entry>
</j:jelly>
