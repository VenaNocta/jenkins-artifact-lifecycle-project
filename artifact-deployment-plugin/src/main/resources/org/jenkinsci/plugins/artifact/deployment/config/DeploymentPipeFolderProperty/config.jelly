<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
	<j:invokeStatic var="title"
		className="org.jenkinsci.plugins.artifact.deployment.config.Messages"
		method="FolderProperty_DisplayName" />
	<j:invokeStatic var="defaultPipeTitle"
		className="org.jenkinsci.plugins.artifact.deployment.config.Messages"
		method="FolderProperty_DefaultPipe" />
	<!-- page -->
	<f:section title="${title}">
		<f:entry title="Inherit upstream Deployment Mappings"
			field="inheritPipes">
			<f:checkbox default="true" />
		</f:entry>
		<f:entry title="${defaultPipeTitle}">
			<f:select field="defaultPipeId" default=""
				style="font-family: monospace;" />
		</f:entry>
		<f:entry title="Name-Pipe Mappings">
			<f:repeatableProperty field="nameMappings2"
				header="Name-Mapping" />
		</f:entry>
	</f:section>
</j:jelly>
