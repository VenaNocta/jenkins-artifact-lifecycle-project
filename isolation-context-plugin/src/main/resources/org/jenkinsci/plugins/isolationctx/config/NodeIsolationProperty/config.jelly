<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
	<f:entry title="Disable Context Isolation (AirGapped Sandbox)"
		field="disabled">
		<f:checkbox />
	</f:entry>
	<f:entry title="Jenkins User's Admin Group Name (for use with sudo)"
		field="adminGroup">
		<f:textbox />
	</f:entry>
</j:jelly>
